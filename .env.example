# SLB / DELFI OAuth (register redirect URI in SLB portal)
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret
APP_KEY=your_app_key
SLB_AUTHORIZATION_URL=https://csi.slb.com/v2/auth
SLB_TOKEN_URL=https://csi.slb.com/v2/token
SLB_REDIRECT_URI=http://localhost:8000/api/callback
SLB_SCOPES=ccm-user-context-cfsservice.slbservice.com
SLB_TOKEN_CLIENT_AUTH=basic

# Optional: require SLB login before POST /api/planned-surveys/xml
# SLB_AUTH_REQUIRED=true

# Where to send the browser after OAuth (defaults to http://127.0.0.1:8000)
# APP_FRONTEND_URL=http://127.0.0.1:8000
# APP_BASE_URL=http://127.0.0.1:8000
